			"properties": {
				"content": {
					"query": "-- -- This is auto-generated code\n-- SELECT\n--     TOP 100 *\n-- FROM\n--     OPENROWSET(\n--         BULK 'https://primarystorageazuredwh.dfs.core.windows.net/silver/enrichedSales/**',\n--         FORMAT = 'PARQUET'\n--     ) AS [result]\n\n\n\nSELECT\n    TOP 100 *\nFROM\n    OPENROWSET(\n        BULK 'enrichedSales',\n        DATA_SOURCE='silver_source',\n        FORMAT = 'PARQUET'\n    ) AS [result]\n\n\n-- if to rename columns, then specify the number of that column: \n-- example chaning 'ORDERID' to 'ORDER_ID'\nSELECT *\nFROM\n    OPENROWSET(\n        BULK 'enrichedSales',\n        DATA_SOURCE='silver_source',\n        FORMAT = 'PARQUET'\n    )\nWITH\n(\n    ORDER_ID VARCHAR(100) 1\n) AS query1;\n",
