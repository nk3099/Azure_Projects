{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-practice-project01"
		},
		"Adf_ADLS2_LS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Adf_ADLS2_LS'"
		},
		"Adf_ADLS2_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlspracticeproject01.dfs.core.windows.net/"
		},
		"HTTP_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"detect_incomingFile_StorageEventTrigger_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/b8035979-0372-4c5a-a906-b01e6b39ed48/resourceGroups/RG-adf_practice/providers/Microsoft.Storage/storageAccounts/adlspracticeproject01"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-practice-project01_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Adf_ADLS2_LS_accountKey": {
						"value": "[parameters('Adf_ADLS2_LS_accountKey')]"
					},
					"Adf_ADLS2_LS_properties_typeProperties_url": {
						"value": "[parameters('Adf_ADLS2_LS_properties_typeProperties_url')]"
					},
					"HTTP_LS_properties_typeProperties_url": {
						"value": "[parameters('HTTP_LS_properties_typeProperties_url')]"
					},
					"detect_incomingFile_StorageEventTrigger_properties_typeProperties_scope": {
						"value": "[parameters('detect_incomingFile_StorageEventTrigger_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}